        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|active|ctaLabel|ctaHref|onNavigate|scrolled|style|key|ref|className|style|children)$/]",
