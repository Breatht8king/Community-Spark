      {
        "selector": "JSXOpeningElement[name.name='SponsorTier'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|name|blurb|items|accent|style|key|ref|className|style|children)$/]",
        "message": "<SponsorTier> doesn't accept that prop. Declared props: level, name, blurb, items, accent, style."
