      {
        "selector": "JSXOpeningElement[name.name='StepCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:flat|bordered)$/]",
        "message": "<StepCard> variant must be one of 'flat' | 'bordered'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimeSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<TimeSlot> doesn't accept that prop. Declared props: selected, disabled, onClick, children, style."
