{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|Inter))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddonItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|price|options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<AddonItem> doesn't accept that prop. Declared props: name, description, price, options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddonTotal'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|note|amount|style|key|ref|className|style|children)$/]",
        "message": "<AddonTotal> doesn't accept that prop. Declared props: label, note, amount, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnouncementBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<AnnouncementBar> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|ink|cream)$/]",
        "message": "<Badge> tone must be one of 'gold' | 'ink' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tagline|showText|titleSize|style|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: size, tagline, showText, titleSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BudgetBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|body|action|style|key|ref|className|style|children)$/]",
        "message": "<BudgetBanner> doesn't accept that prop. Declared props: label, title, body, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|fullWidth|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, fullWidth, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|outline|ghost|inkGhost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'dark' | 'outline' | 'ghost' | 'inkGhost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Calendar'] > JSXAttribute > JSXIdentifier[name!=/^(?:month|year|selected|onSelect|unavailable|style|key|ref|className|style|children)$/]",
        "message": "<Calendar> doesn't accept that prop. Declared props: month, year, selected, onSelect, unavailable, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EstimateNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|children|style|key|ref|className|style|children)$/]",
        "message": "<EstimateNotice> doesn't accept that prop. Declared props: lead, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|category|duration|title|description|facts|includes|addons|priceNote|vendorNote|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<EventCard> doesn't accept that prop. Declared props: image, category, duration, title, description, facts, includes, addons, priceNote, vendorNote, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExperienceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|children|style|key|ref|className|style|children)$/]",
        "message": "<ExperienceCard> doesn't accept that prop. Declared props: number, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|children|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: question, children, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|tag|title|body|large|style|key|ref|className|style|children)$/]",
        "message": "<FeatureTile> doesn't accept that prop. Declared props: image, tag, title, body, large, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: active, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|as|type|help|options|placeholder|value|onChange|rows|style|key|ref|className|style|children)$/]",
        "message": "<FormField> doesn't accept that prop. Declared props: label, as, type, help, options, placeholder, value, onChange, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|select|textarea)$/]",
        "message": "<FormField> as must be one of 'input' | 'select' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FounderCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|role|name|bio|tags|style|key|ref|className|style|children)$/]",
        "message": "<FounderCard> doesn't accept that prop. Declared props: initials, role, name, bio, tags, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GalleryItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|caption|badge|height|style|key|ref|className|style|children)$/]",
        "message": "<GalleryItem> doesn't accept that prop. Declared props: image, caption, badge, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|eyebrow|title|body|proof|actions|minHeight|style|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: image, eyebrow, title, body, proof, actions, minHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartnerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|title|body|items|split|note|action|style|key|ref|className|style|children)$/]",
        "message": "<PartnerCard> doesn't accept that prop. Declared props: kind, label, title, body, items, split, note, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartnerCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:community|sponsor)$/]",
        "message": "<PartnerCard> kind must be one of 'community' | 'sponsor'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PolicyCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|children|style|key|ref|className|style|children)$/]",
        "message": "<PolicyCard> doesn't accept that prop. Declared props: number, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tier|name|amount|amountSuffix|blurb|features|action|featured|badge|style|key|ref|className|style|children)$/]",
        "message": "<PriceCard> doesn't accept that prop. Declared props: tier, name, amount, amountSuffix, blurb, features, action, featured, badge, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: placeholder, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|body|align|onDark|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: label, title, body, align, onDark, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:split|center)$/]",
        "message": "<SectionHead> align must be one of 'split' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDark|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: onDark, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|blurb|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: columns, blurb, style."
